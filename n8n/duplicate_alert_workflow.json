{
  "name": "ConsultBae Duplicate Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "consultbae-person-check",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ],
      "webhookId": "consultbae-person-check"
    },
    {
      "parameters": {
        "jsCode": "const p=$json.body || $json;\nreturn [{json:{\n  name:String(p.name||'').trim(),\n  email:String(p.email||'').trim().toLowerCase(),\n  phone:String(p.phone||'').replace(/\\\\D/g,'').replace(/^91(?=\\\\d{10}$)/,'')\n}}];"
      },
      "id": "Normalize",
      "name": "Normalize Person",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -360,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/api/check-person",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "Check",
      "name": "Check SQLite via API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$json.duplicate}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "IF",
      "name": "Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        140,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "consultbae-automation@example.com",
        "toEmail": "replace-with-your-email@example.com",
        "subject": "ConsultBae duplicate person detected",
        "text": "Duplicate detected for {{$json.name}}. Match: {{$json.match_reason}}",
        "options": {}
      },
      "id": "Email",
      "name": "Send Duplicate Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        400,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ok:true, duplicate:$json.duplicate, match_reason:$json.match_reason || null}) }}",
        "options": {}
      },
      "id": "Response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        400,
        120
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check": {
      "main": [
        [
          {
            "node": "IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF": {
      "main": [
        [
          {
            "node": "Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email": {
      "main": [
        [
          {
            "node": "Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "consultbae-v1"
}